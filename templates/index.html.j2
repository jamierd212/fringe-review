<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edinburgh Festivals Top-Rated Shows {{ year }}</title>
<meta name="description" content="Edinburgh Fringe &amp; festivals shows ranked by highest rating, featuring every published review we can find.">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta property="og:site_name" content="Edinburgh Festivals Top-Rated Shows">
<meta property="og:type" content="website">
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta property="og:title" content="Edinburgh Festivals {{ year }} &ndash; Top-Rated Shows">
<meta property="og:description" content="{{ rated }} star ratings across {{ show_count }} shows, collated from {{ publications|length }} publications and ranked by highest rating.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Edinburgh Festivals {{ year }} &ndash; Top-Rated Shows">
<meta name="twitter:description" content="{{ rated }} star ratings across {{ show_count }} shows, ranked by highest rating.">
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --rule: #ecdcd9;
    --star: #c62828;            /* red, replaces the old gold */
    --bg: #f9e4e0;              /* light red page background */
    --card: #ffffff;            /* boxes deliberately left white */
  }
  * { box-sizing: border-box; }
  /* The `hidden` attribute is only `display: none` in the user-agent
     stylesheet, so ANY author rule setting display beats it — `.show` is
     display:flex, which meant search hid rows in the DOM while leaving every
     one of them on screen. */
  [hidden] { display: none !important; }
  body {
    margin: 0; padding: 1.1rem .6rem 4rem; background: var(--bg); color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
  }
  .wrap { max-width: 820px; margin: 0 auto; }
  header { border-bottom: 3px solid #ccc; padding-bottom: .1rem; margin-bottom: .3rem; }
  h1 { font-size: 2rem; margin: 0 0 .15rem; letter-spacing: -.01em; line-height: 1.12; }
  h1 .line2 { display: block; }   /* inherits h1's size, weight and colour */
  /* Its own line-height rather than the body's 1.55: at .85rem that leaves
     several pixels of leading hanging under the last line, which read as a
     gap above the rule that no margin was actually setting. */
  .sub { color: var(--muted); font-size: .85rem; line-height: 1.28; }
  .meta {
    color: var(--muted); font-size: .7rem; line-height: 1.3;
    margin: .4rem 0 .6rem;
  }

  .show {
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: .4rem .7rem; margin-bottom: .27rem; display: flex; gap: .6rem;
  }
  .pos {
    /* Matched to h2 so the number and the show title sit on the same line and
       at the same weight — the number is a label, not the headline. */
    font-size: 1.15rem; font-weight: 700; color: var(--muted);
    line-height: 1.35; min-width: 1.9rem;
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .body { flex: 1; min-width: 0; }
  .titlerow { display: flex; gap: .7rem; align-items: baseline; justify-content: space-between; }
  .titlewrap { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; min-width: 0; }
  h2 { font-size: 1.15rem; margin: 0 0 .05rem; line-height: 1.35; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--star); }
  .meta-right { flex: none; display: flex; gap: .45rem; align-items: baseline; }
  .genre {
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase;
    color: var(--muted); border: 1px solid var(--rule); border-radius: 999px;
    padding: .12rem .55rem;
  }
  /* The performer is no longer shown on the board — the list reads faster as
     titles alone — but it is still in data-find, so searching a comedian's name
     still finds their show. */
  @media (max-width: 560px) {
    .titlerow { flex-direction: column; gap: .2rem; }
    .meta-right { align-self: flex-start; }
  }

  ul.reviews { list-style: none; margin: .08rem 0 0; padding: 0; }
  /* The stars set the height of a review row, not the publication name, so
     shrinking the name alone buys nothing vertically — the line-height and the
     padding are what actually close the rows up. The stars are left at their
     size deliberately: they are the thing being read. */
  ul.reviews li {
    display: flex; gap: .7rem; align-items: baseline;
    padding: .05rem 0; line-height: 1.18; border-top: 1px solid var(--rule);
    flex-wrap: wrap;
  }
  ul.reviews li:first-child { border-top: 0; }
  .rating {
    font-family: ui-monospace, Menlo, monospace; letter-spacing: .08em;
    white-space: nowrap; color: var(--star);
    font-size: 1.15rem;         /* slightly larger than the surrounding text */
  }
  .s3 .rating, .s2 .rating, .s1 .rating { color: var(--muted); }
  /* Left at body size. Tried at .88rem to fit more shows on a screen, and it
     did read as smaller rather than tidier — the names are what you scan when
     you already trust the stars. The height came from the rows, not here. */
  .pub { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  a { color: inherit; text-decoration-color: var(--rule); text-underline-offset: 2px; }
  /* Publication names are links, but a column of underlines competes with the
     stars beside them. Underline only on hover, so they still read as links. */
  .pub a { text-decoration: none; }
  .pub a:hover { text-decoration: underline; text-decoration-color: var(--ink); }
  a:hover { text-decoration-color: var(--ink); }

  /* The controls follow you down the page. Sticky rather than fixed, so they
     occupy their own space at the top and nothing has to be padded around them.
     The background is opaque or the list shows through as it passes under. */
  .topbar { position: sticky; top: 0; z-index: 50; background: var(--bg); }
  .topbar.compact {
    box-shadow: 0 1px 0 var(--rule), 0 6px 12px -10px rgba(0,0,0,.35);
    /* Padding rather than a margin on the nav inside: a child's top margin
       collapses through the container, so the buttons sat flush against the top
       of the screen with the gap applied but not visible. */
    padding: .4rem 0 .45rem;
  }
  /* Once scrolled, the year tabs give up their space: the bar is there to keep
     filtering and searching within reach, and you can still reach the years by
     going back to the top. */
  .topbar.compact nav.years a { display: none; }
  .topbar.compact nav.years { margin-top: 0; }
  .to-top {
    padding: .3rem .85rem; border: 1px solid var(--rule); border-radius: 999px;
    font: inherit; font-size: .9rem; font-weight: 700; color: var(--muted);
    background: var(--card); cursor: pointer;
  }
  .to-top:hover { border-color: var(--ink); color: var(--ink); }
  nav.years { display: flex; gap: .4rem; margin: .55rem 0 0; flex-wrap: wrap; }
  nav.years a {
    display: inline-block; padding: .3rem .85rem; border: 1px solid var(--rule);
    border-radius: 999px; text-decoration: none; font-size: .9rem;
    color: var(--muted); background: var(--card);
  }
  nav.years a:hover { border-color: var(--ink); color: var(--ink); }
  nav.years a[aria-current="page"] {
    background: var(--ink); border-color: var(--ink); color: var(--bg);
    font-weight: 700;
  }

  nav.years .filter-toggle {
    margin-left: auto; padding: .3rem .85rem; border: 1px solid var(--rule);
    border-radius: 999px; font: inherit; font-size: .9rem; color: var(--muted);
    background: var(--card); cursor: pointer;
  }
  nav.years .filter-toggle:hover { border-color: var(--ink); color: var(--ink); }
  nav.years .filter-toggle[aria-expanded="true"] {
    background: var(--ink); border-color: var(--ink); color: var(--bg);
  }
  nav.years .search { margin-left: .4rem; }
  .filters {
    display: flex; flex-wrap: wrap; gap: .45rem .8rem; align-items: start;
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: .5rem .7rem; margin: .5rem 0 0; font-size: .85rem;
  }
  .filters label { display: flex; flex-direction: column; gap: .1rem; color: var(--muted); }
  .filters select {
    font: inherit; padding: .15rem .35rem; border: 1px solid var(--rule);
    border-radius: 4px; background: #fff; color: var(--ink); max-width: 15rem;
  }
  /* The open list, not the closed box — the box was tightened earlier and the
     rows inside it were not. How far this gets is up to the browser: a desktop
     browser draws the list itself and honours all of it, Android honours some,
     and iOS opens a native picker that ignores CSS entirely. */
  .filters option, .filters optgroup {
    font-size: .85rem; line-height: 1.15; padding: .08rem .4rem; min-height: 0;
  }
  /* iOS opens a native picker for a <select> and ignores author CSS entirely,
     so the only way to control the row spacing on a phone is to stop using it.
     The <select> stays in the DOM and stays authoritative — everything else
     still reads .value and listens for change — and this draws a list on top of
     it. Rows are 34px rather than the picker's 44: tight enough to see roughly
     twice as many venues at once, still big enough to hit with a thumb. */
  .picker { position: relative; }
  .picker > button.picker-open {
    font: inherit; font-size: .85rem; text-align: left;
    padding: .15rem 1.4rem .15rem .35rem; border: 1px solid var(--rule);
    border-radius: 4px; background: #fff; color: var(--ink);
    width: 15rem; max-width: 100%; cursor: pointer;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .picker > button.picker-open::after {
    content: ""; position: absolute; right: .5rem; top: 50%;
    width: .4rem; height: .4rem; margin-top: -.32rem; pointer-events: none;
    border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg);
  }
  .picker-panel {
    position: absolute; z-index: 40; top: calc(100% + 2px); left: 0;
    width: 17rem; max-width: 84vw; background: #fff;
    border: 1px solid var(--rule); border-radius: 6px;
    box-shadow: 0 6px 20px rgba(0,0,0,.13); overflow: hidden;
  }
  .picker-search {
    font: inherit; font-size: .85rem; width: 100%; border: 0;
    border-bottom: 1px solid var(--rule); padding: .4rem .55rem; color: var(--ink);
  }
  .picker-list { max-height: 15rem; overflow-y: auto; -webkit-overflow-scrolling: touch; }
  .picker-list [role="option"] {
    padding: .42rem .55rem; font-size: .85rem; line-height: 1.15;
    cursor: pointer; border-top: 1px solid var(--rule);
  }
  .picker-list [role="option"]:first-child { border-top: 0; }
  .picker-list [role="option"][aria-selected="true"] { background: var(--ink); color: #fff; }
  .picker-list [role="option"][aria-disabled="true"] { color: var(--muted); cursor: default; }
  .picker-list .picker-group {
    padding: .3rem .55rem .18rem; font-size: .7rem; letter-spacing: .04em;
    text-transform: uppercase; color: var(--muted); background: var(--bg);
  }
  .picker-list .picker-rule { height: 1px; background: var(--rule); margin: .15rem 0; }
  .picker-empty { padding: .5rem .55rem; font-size: .85rem; color: var(--muted); }
  .filters .times { display: flex; align-items: center; gap: .35rem; }
  /* Label beside the box rather than above it. "Tickets available" is the
     longest label of the four, and stacked it pushed the panel a row taller
     while leaving most of that row empty. Sized to content so it does not
     claim half a row it does not need. */
  .filters label.inline {
    flex: 0 1 auto; flex-direction: row; align-items: center; gap: .4rem;
  }
  .filters #f-clear {
    font: inherit; padding: .3rem .7rem; border: 1px solid var(--rule);
    border-radius: 999px; background: var(--card); color: var(--muted); cursor: pointer;
    /* The row is aligned to the top so the genre chips can grow downwards, but
       Clear has no label above it, so that left it floating above the time
       boxes it sits beside. Pinned to the bottom, it lines up with them. */
    align-self: end;
  }
  .filters #f-clear:hover { border-color: var(--ink); color: var(--ink); }
  /* Chosen genres, listed under the picker so several can be held at once.
     The whole chip is the remove button: there is no other action it could
     have, and a separate × is a small target on a phone. */
  .filters .chosen {
    display: flex; flex-wrap: wrap; gap: .3rem;
    max-width: 15rem;          /* matches the select, so chips wrap under it */
    margin: .25rem 0 0;
  }
  .filters .chosen:empty { display: none; }
  .filters .chosen button {
    font: inherit; font-size: .8rem; line-height: 1.3;
    padding: .15rem .5rem; border: 1px solid var(--ink); border-radius: 999px;
    background: var(--ink); color: var(--card); cursor: pointer;
    display: inline-flex; align-items: baseline; gap: .3rem; max-width: 100%;
  }
  .filters .chosen .chip-name {
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0;
  }
  .filters .chosen button::after { content: "×"; opacity: .7; flex: none; }
  .filters .chosen button:hover { opacity: .82; }
  @media (max-width: 560px) {
    nav.years .search { margin-left: 0; }
    nav.years input[type="search"] { width: 100%; }
    /* Two to a row on a phone. The controls are a fixed 15rem so they line up
       on a wide screen, but two of those are wider than the phone, so Location
       and Genre each took a row of their own and the panel ran down the page.
       Half the row each, and they sit side by side as they do on desktop. */
    .filters label { flex: 1 1 calc(50% - .45rem); min-width: 0; }

    /* The time pair takes exactly the width its two boxes need, rather than
       half the row like Location and Genre or the whole of it, which left Clear
       stranded on a line of its own. Sized to content, there is room for Clear
       beside it. */
    .filters label.span { flex: 0 0 auto; }
    .picker { display: block; }
    .picker > button.picker-open,
    .filters select,
    .filters .chosen { width: 100%; max-width: 100%; }
    .picker-panel { width: 17rem; max-width: 92vw; }
    /* An inline label keeps its box beside it rather than under it, so the box
       cannot take the whole row — that pushed "Tickets available" onto two
       lines and made the row it was meant to save taller than before.

       The box is held narrow so that Clear fits on the row beside it. At 9.5rem
       the pair needed 332.3px of a 331.6px row and Clear dropped to a line of
       its own over three quarters of a pixel; 9rem leaves 8px of slack, which
       survives a font that measures slightly differently. */
    .filters label.inline { white-space: nowrap; }
    .filters label.inline select { width: auto; min-width: 0; max-width: 9rem; }
  }
  nav.years .search { position: relative; }
  /* The browser's own clear control is suppressed so there is never a pair of
     them, and so this one can be the same size everywhere. */
  nav.years input[type="search"]::-webkit-search-cancel-button { display: none; }
  nav.years #q-clear {
    position: absolute; right: .5rem; top: 50%; transform: translateY(-50%);
    border: 0; background: none; cursor: pointer; padding: 0 .3rem;
    font-size: 1.15rem; line-height: 1; color: var(--muted);
  }
  nav.years #q-clear:hover { color: var(--ink); }
  nav.years input[type="search"] {
    padding: .3rem 1.8rem .3rem .85rem; border: 1px solid var(--rule); border-radius: 999px;
    font-size: .9rem; font-family: inherit; color: var(--ink);
    /* Inputs default to line-height: normal while the pills inherit the body's
       1.55, which left the search box 5px shorter than everything beside it. */
    line-height: inherit;
    background: var(--card); width: 8.5rem; -webkit-appearance: none;
  }
  nav.years input[type="search"]:focus {
    outline: none; border-color: var(--ink);
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .nomatch { color: var(--muted); font-style: italic; margin: 1.5rem 0; }

  .placeholder { color: var(--muted); font-size: 1.05rem; margin: 2rem 0 3rem; }
  h3.section { margin: 2.5rem 0 .75rem; font-size: 1rem; text-transform: uppercase;
               letter-spacing: .08em; color: var(--muted); }
  .rest { columns: 2; column-gap: 1.5rem; font-size: .9rem; }
  .rest div { break-inside: avoid; margin-bottom: .4rem; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule);
           color: var(--muted); font-size: .8rem; }
  @media (max-width: 560px) { .rest { columns: 1; } }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Edinburgh Festivals<span class="line2">Top-Rated Shows</span></h1>
  <p class="sub">
    Edinburgh Fringe &amp; festivals shows ranked by highest rating, featuring
    every published review we can find.
  </p>
</header>

{#- Outside the header on purpose. A sticky element only sticks within its own
    parent, so inside the header it scrolled away with it. And one set of
    controls rather than a second copy pinned to the top: two search boxes would
    be two states to keep in step, and they would drift. -#}
{% if nav|length > 1 %}
<div class="topbar" id="topbar">
  <nav class="years" aria-label="Festival year">
    <button type="button" class="to-top" id="to-top" hidden
            aria-label="Back to top">&uarr; Top</button>
    {% for entry in nav %}
    <a href="{{ entry.href }}"{% if entry.current %} aria-current="page"{% endif %}>{{ entry.year }}</a>
    {% endfor %}
    {#- No programme, no filter. Past years lose their venues and times when the
        festival takes its pages down, so offering the control there would open
        an empty panel. -#}
    {% if venues %}
    <button type="button" class="filter-toggle" id="filter-toggle" aria-expanded="false"
            aria-controls="filters" hidden>Filter</button>
    {% endif %}
    <label class="search" hidden>
      <span class="visually-hidden">Search shows</span>
      <input type="search" id="q" placeholder="Search shows&hellip;"
             autocomplete="off" spellcheck="false">
      {#- Our own clear button rather than the one the browser draws: WebKit
          hides its ✕ on a touch device, which is where clearing a search by
          hand is most tedious. Hidden until there is something to clear. -#}
      <button type="button" id="q-clear" aria-label="Clear search" hidden>&times;</button>
    </label>
  </nav>
  {# Populated from the festival's own programme; absent for past years, whose
     programme pages come down once the shows stop selling. #}
  {% if venues %}
  <div class="filters" id="filters" hidden>
    <label>Location
      <select id="f-venue">
        <option value="">Any venue</option>
        {%- if venue_groups %}
        <optgroup label="Areas">
          {% for g in venue_groups %}<option value="g:{{ g }}">{{ g }}</option>{% endfor %}
        </optgroup>
        {%- endif %}
        {#- A disabled option is the only separator a <select> reliably renders
            across browsers; optgroup labels alone did not read as a division. -#}
        <option value="" disabled>──────────</option>
        <optgroup label="All venues">
          {% for v in venues %}<option value="v:{{ v }}">{{ v }}</option>{% endfor %}
        </optgroup>
      </select>
      <span class="chosen" id="f-venue-chosen"></span>
    </label>
    {#- Only the Fringe classifies its shows, so this appears only when there is
        something to choose from. Sections first, then their tags scoped to the
        section they belong to: the Fringe's tags are a flat vocabulary reused
        everywhere, so "Storytelling" alone would mean both a comedian and a
        play, whereas "Comedy – Storytelling" means one of them. #}
    {% if genre_sections %}
    {#- A picker that adds to a list, rather than a multiple-select: a native
        multi-select needs ctrl-click, which does not exist on a phone, and
        shows its choices in a scrolling box. Here what you have chosen stays
        visible underneath, and tapping one removes it. #}
    <label>Genre
      <select id="f-genre">
        <option value="">Any genre</option>
        <optgroup label="Genres">
          {% for value, name, n in genre_sections %}<option value="{{ value }}">{{ name }}</option>{% endfor %}
        </optgroup>
        <option value="" disabled>──────────</option>
        <optgroup label="Sub-genres">
          {% for value, name, n in genre_subs %}<option value="{{ value }}">{{ name }}</option>{% endfor %}
        </optgroup>
      </select>
      <span class="chosen" id="f-genre-chosen"></span>
    </label>
    {% endif %}
    <label class="span">Starts between
      <span class="times">
        {#- Whole hours rather than a time picker: show times are only useful
            to about the hour when you are deciding what to see, and a native
            time input is fiddly on a phone. The list runs 09:00 round to 08:00
            so a festival day reads in order — the first show of the day at the
            top, the small hours at the bottom where they belong. -#}
        <select id="f-from">
          <option value="">Any time</option>
          {% for h in hours %}<option value="{{ h }}">{{ h }}</option>{% endfor %}
        </select>
        <span>and</span>
        <select id="f-to">
          <option value="">Any time</option>
          {% for h in hours %}<option value="{{ h }}">{{ h }}</option>{% endfor %}
        </select>
      </span>
    </label>
    {#- Under the times, and set on one line: its label is the longest of the
        four and stacked it made the panel a row taller for no gain.

        The dates come from the programme's own per-performance status — the
        field behind the calendar on a show's page — so this says what that
        calendar says. A date counts when a ticket can be bought for it, from
        whoever sells it. That includes "no allocation, contact venue", a third
        of all performances, which means the venue sells its own rather than
        that there are none: four of the current top twelve are entirely that
        status and every one of them is bookable. Only cancelled dates are
        excluded. -#}
    {% if playing %}
    <label class="inline">Tickets available
      <select id="f-playing">
        {#- "Any date" is the neutral state and filters nothing: the board
            lists what was acclaimed, whether or not it is still selling. The
            dates below answer the ticket question. -#}
        <option value="">Any date</option>
        <option value="today">Today</option>
        {#- Every date the board has a show on. Dates already past are removed
            by the browser on load, against its own clock, because which ones
            have gone depends on when the page is read rather than when it was
            written. -#}
        <option value="" disabled>──────────</option>
        {% for offset, label in playing_dates %}
        <option value="d{{ offset }}">{{ label }}</option>
        {% endfor %}
      </select>
    </label>
    {% endif %}
    <button type="button" id="f-clear">Clear</button>

  </div>
  {% endif %}
</div>{# /topbar #}
{% endif %}

<p class="meta">
  Updated {{ updated }}{% if rated %} &middot;
  {{ rated }} rated reviews across {{ show_count }} shows{% endif %}
</p>

{% for position, show in placed %}
<article class="show{% if position <= 3 %} top{% endif %}"
         data-find="{{ (show.title ~ ' ' ~ (show.performer or '') ~ ' ' ~ show.genre)|lower }}"
         data-venue="{{ show.venue }}" data-vgroup="{{ venue_group(show.venue) }}"
         data-genres="{{ genre_keys(show)|join(';') }}"
         data-days="{{ playing.get(show.id, '') }}"
         data-start="{{ show.start_minutes }}">
  <div class="pos">{{ position }}</div>
  <div class="body">
    <div class="titlerow">
      <span class="titlewrap">
        <h2><a href="{{ show.page }}" title="All reviews for {{ show.title }}">{{ show.title }}</a></h2>
      </span>
      <span class="meta-right">
        {% if show.genre %}<span class="genre">{{ show.genre }}</span>{% endif %}
      </span>
    </div>
    <ul class="reviews">
      {% for level in [5, 4, 3, 2, 1] %}
        {% for review in show.at(level) %}
        <li class="s{{ level }}">
          <span class="rating" title="{{ level }} out of 5">{{ level|stars }}</span>
          <span class="pub"><a href="{{ review.url }}" target="_blank" rel="nofollow noopener">{{ review.publication }}</a></span>
        </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</article>
{% else %}
<p class="placeholder"><em>2026 reviews go live Wednesday 5th August</em></p>
{% endfor %}

{% if rest %}
<h3 class="section">Also reviewed &mdash; no 4 or 5 star reviews yet</h3>
<div class="rest">
  {% for show in rest %}
  <div data-find="{{ show.title|lower }}"
       data-venue="{{ show.venue }}" data-vgroup="{{ venue_group(show.venue) }}"
       data-genres="{{ genre_keys(show)|join(';') }}"
       data-days="{{ playing.get(show.id, '') }}"
       data-start="{{ show.start_minutes }}">
    {{ show.title }}
    {% for review in show.reviews %}
      <a href="{{ review.url }}" target="_blank" rel="nofollow noopener" title="{{ review.publication }}">{{ review.stars }}&#9733;</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}

<footer>
  {% if publications %}<p>
    <strong>Sources:</strong> {{ publications|join(", ") }}.
  </p>{% endif %}
  <p>
    Ratings are collated automatically from publicly available reviews and link
    back to the publication. Ratings given on other scales are converted to
    stars, rounded down, and labelled. Star ratings are the publications&rsquo;
    own; this page only counts them.
  </p>
  <p>
    Spotted a mistake? <a href="{{ contact_url }}" rel="noopener">{{ contact_label }}</a>.
    Please allow 24 hours for new reviews to be collected from the web
    and we&rsquo;ll fix it. Publications wanting a rating amended or removed:
    same route &mdash; it will be actioned.
  </p>
</footer>

</div>

<p class="nomatch" id="nomatch" hidden></p>

<script>
// Search is client-side because the site is static files on a CDN. The box is
// hidden in the markup and revealed here, so it never appears as a dead control
// for anyone without JavaScript.
(function () {
  var box = document.querySelector('.search');
  var input = document.getElementById('q');
  var none = document.getElementById('nomatch');
  if (!box || !input) return;
  box.hidden = false;

  // The filter button is revealed here too, rather than several hundred lines
  // below with the rest of the filter code. It is hidden in the markup so it
  // never shows as a dead control without JavaScript, which means anything
  // throwing before the reveal takes the button with it — and the reveal was
  // last in the file, behind the pickers, the chips, the URL state and the
  // sticky bar. Mobile Chrome showed the search box and no Filter button, which
  // is exactly that shape of failure.
  var filterToggle = document.getElementById('filter-toggle');
  var filterPanel = document.getElementById('filters');
  if (filterToggle && filterPanel) {
    filterToggle.hidden = false;
    filterToggle.addEventListener('click', function () {
      var open = filterToggle.getAttribute('aria-expanded') === 'true';
      filterToggle.setAttribute('aria-expanded', String(!open));
      filterPanel.hidden = open;
    });
  }

  // Read the text once. Doing it per keystroke means touching a thousand
  // elements' DOM text on every character typed.
  var rows = [].map.call(document.querySelectorAll('[data-find]'), function (el) {
    return { el: el, text: el.getAttribute('data-find') };
  });
  var section = document.querySelector('h3.section');
  var rest = document.querySelector('.rest');

  // Filters. The panel only exists where the festival programme supplied
  // venues and times, so every reference below is optional.
  var toggle = document.getElementById('filter-toggle');
  var panel = document.getElementById('filters');
  var fVenue = document.getElementById('f-venue');
  var fGenre = document.getElementById('f-genre');
  var fGenreChosen = document.getElementById('f-genre-chosen');
  var fVenueChosen = document.getElementById('f-venue-chosen');
  // Assigned further down, once multiPick exists; apply() only ever runs from
  // an event, by which time both are built.
  var genrePick = null, venuePick = null;
  var fFrom = document.getElementById('f-from');
  var fTo = document.getElementById('f-to');
  var fClear = document.getElementById('f-clear');
  var fPlaying = document.getElementById('f-playing');

  rows.forEach(function (r) {
    r.venue = r.el.getAttribute('data-venue') || '';
    r.vgroup = r.el.getAttribute('data-vgroup') || '';
    // A show carries its section and every tag scoped to it, so "COMEDY" and
    // "COMEDY|stand-up" both match in one lookup. Semicolons separate them
    // because the tags themselves contain spaces.
    r.genres = (r.el.getAttribute('data-genres') || '').split(';');
    r.start = parseInt(r.el.getAttribute('data-start'), 10);
    // Days the show can still be booked, as offsets from 1 August. Parsed once
    // here rather than per keystroke: this is the only filter whose data is a
    // list per row, and re-splitting eight hundred of them on every character
    // typed into the search box was the one thing that could make it stutter.
    var days = r.el.getAttribute('data-days') || '';
    r.days = days ? days.split(' ').map(Number) : [];
  });

  // Today, as the same offset. Computed in the browser rather than baked in at
  // build time: the page is rebuilt each morning, but it is also read at
  // midnight, from a cache, and by people whose browser has been open since
  // yesterday. A "Today" that means the day the file was written would be
  // quietly wrong for all of them.
  var epoch = Date.UTC.apply(null, '{{ playing_epoch }}'.split('-').map(function (n, i) {
    return i === 1 ? Number(n) - 1 : Number(n);
  }));
  function todayOffset() {
    var now = new Date();
    return Math.round((Date.UTC(now.getFullYear(), now.getMonth(), now.getDate())
                       - epoch) / 86400000);
  }

  function minutes(value) {
    if (!value) return null;
    var bits = value.split(':');
    return parseInt(bits[0], 10) * 60 + parseInt(bits[1], 10);
  }

  function apply() {
    var q = input.value.trim().toLowerCase();
    var venues = venuePick ? venuePick.values() : [];
    var genres = genrePick ? genrePick.values() : [];

    var from = fFrom ? minutes(fFrom.value) : null;
    var to = fTo ? minutes(fTo.value) : null;
    var when = fPlaying ? fPlaying.value : '';
    var today = fPlaying ? todayOffset() : 0;
    var hits = 0;
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      var show = !q || r.text.indexOf(q) !== -1;
      // "g:" is an area, "v:" a single venue. Each show carries its own area,
      // so an area match is one comparison rather than a lookup table. Several
      // choices widen the search, as with genre: an area and a venue inside it
      // both match the same show, and it is shown once either way.
      if (show && venues.length) {
        show = false;
        for (var v = 0; v < venues.length; v++) {
          var pick = venues[v];
          if (pick.charAt(0) === 'g' ? r.vgroup === pick.slice(2)
                                     : r.venue === pick.slice(2)) { show = true; break; }
        }
      }
      // Several genres widen the search rather than narrowing it: choosing
      // Comedy and Theatre means either, which is the only reading that can
      // return anything, since a show belongs to one section. A show with no
      // genre at all matches none of them, so it drops out rather than being
      // claimed as something we do not know it to be.
      if (show && genres.length) {
        show = false;
        for (var g = 0; g < genres.length; g++) {
          if (r.genres.indexOf(genres[g]) !== -1) { show = true; break; }
        }
      }
      // "Any date" filters nothing. The board is a record of what was
      // acclaimed, not a list of what is on sale, and a show that has finished
      // its run or sold out was no less good for it — dropping the number one
      // show because the festival is not the one selling it would fail at the
      // only job this page has.
      //
      // Choosing a date is a different question, and there it does filter. A
      // show we hold no calendar for goes then, because claiming it plays that
      // night is a claim we cannot make.
      if (show && when) {
        if (!r.days.length) {
          show = false;
        } else if (when === 'today') {
          show = r.days.indexOf(today) !== -1;
        } else {
          show = r.days.indexOf(parseInt(when.slice(1), 10)) !== -1;
        }
      }
      // A show with no known time cannot satisfy a time window. Hiding it is
      // the honest answer: we do not know when it is on, so we cannot claim
      // it starts in the hour someone asked for.
      if (show && (from !== null || to !== null)) {
        if (r.start < 0) {
          // No known time cannot satisfy a time window: we do not know when it
          // is on, so we cannot claim it starts in the hour someone asked for.
          show = false;
        } else if (from !== null && to !== null && to < from) {
          // The window runs past midnight — 22:00 to 00:00 is the one people
          // actually want at that hour — so it is two ranges, not one.
          show = r.start >= from || r.start <= to;
        } else {
          show = (from === null || r.start >= from)
              && (to === null || r.start <= to);
        }
      }
      r.el.hidden = !show;
      if (show) hits++;
    }
    // The "also reviewed" heading and its column are meaningless when nothing
    // in them matches.
    if (rest) {
      var anyRest = [].some.call(rest.querySelectorAll('[data-find]'), function (e) {
        return !e.hidden;
      });
      rest.hidden = !anyRest;
      if (section) section.hidden = !anyRest;
    }
    var filtering = q || venues.length || genres.length
                 || from !== null || to !== null;
    none.hidden = !(filtering && hits === 0);
    if (!none.hidden) none.textContent = 'No shows match those filters.';
    writeState();
  }


  // Draw the dropdowns ourselves, because iOS will not let us style its own.
  // The <select> stays in the DOM and stays the source of truth: this sets its
  // value and fires change, so the filtering, the chips and Clear are untouched
  // and all of it still works if this script never runs.
  function makePicker(select) {
    if (!select) return;
    var wrap = document.createElement('span');
    wrap.className = 'picker';
    select.parentNode.insertBefore(wrap, select);
    wrap.appendChild(select);
    select.style.display = 'none';

    var button = document.createElement('button');
    button.type = 'button';
    button.className = 'picker-open';
    button.setAttribute('aria-haspopup', 'listbox');
    button.setAttribute('aria-expanded', 'false');
    wrap.appendChild(button);

    var panel = null;

    function label() {
      var o = select.options[select.selectedIndex];
      button.textContent = o ? o.text : '';
    }

    function close() {
      if (panel) { panel.remove(); panel = null; }
      button.setAttribute('aria-expanded', 'false');
    }

    function choose(value) {
      select.value = value;
      select.dispatchEvent(new Event('change', {bubbles: true}));
      label();
      close();
      button.focus();
    }

    function open() {
      if (panel) { close(); return; }
      panel = document.createElement('div');
      panel.className = 'picker-panel';
      var list = document.createElement('div');
      list.className = 'picker-list';
      list.setAttribute('role', 'listbox');

      // Long lists get a filter box. The native picker has no way to search
      // three hundred venues, so this is the one place the custom list is
      // plainly better rather than merely tidier.
      var search = null;
      if (select.options.length > 40) {
        search = document.createElement('input');
        search.type = 'search';
        search.className = 'picker-search';
        search.placeholder = 'Type to narrow';
        panel.appendChild(search);
      }
      panel.appendChild(list);

      function draw(query) {
        list.textContent = '';
        var q = (query || '').trim().toLowerCase();
        var shown = 0;
        var lastGroup = null;
        [].forEach.call(select.options, function (o) {
          var group = o.parentNode.tagName === 'OPTGROUP' ? o.parentNode.label : null;
          // The separator is a disabled blank option; it is furniture, and it
          // makes no sense in a list someone is filtering.
          if (o.disabled && !o.value) {
            if (!q) { var r = document.createElement('div'); r.className = 'picker-rule'; list.appendChild(r); }
            return;
          }
          if (q && o.text.toLowerCase().indexOf(q) === -1) return;
          if (group && group !== lastGroup) {
            var g = document.createElement('div');
            g.className = 'picker-group';
            g.textContent = group;
            list.appendChild(g);
            lastGroup = group;
          }
          var row = document.createElement('div');
          row.setAttribute('role', 'option');
          row.textContent = o.text;
          if (o.value === select.value) row.setAttribute('aria-selected', 'true');
          if (o.disabled) {
            row.setAttribute('aria-disabled', 'true');
          } else {
            row.addEventListener('click', function () { choose(o.value); });
          }
          list.appendChild(row);
          shown++;
        });
        if (!shown) {
          var none = document.createElement('div');
          none.className = 'picker-empty';
          none.textContent = 'Nothing matches';
          list.appendChild(none);
        }
      }

      draw('');
      if (search) {
        search.addEventListener('input', function () { draw(search.value); });
      }
      wrap.appendChild(panel);
      // A panel hanging off the right edge does not merely get clipped - it
      // widens the page and lets the whole thing scroll sideways. Pulling it
      // left fixes that, but only until the control is narrow and near the left
      // edge, where pulling it left puts it off the other side. So it is pulled
      // in from whichever edge it exceeds, and never past the opposite one.
      var room = document.documentElement.clientWidth;
      var here = wrap.getBoundingClientRect().left;
      var wide = panel.offsetWidth;
      var offset = 0;
      if (here + wide > room - 4) offset = room - 4 - wide - here;
      if (here + offset < 4) offset = 4 - here;
      panel.style.left = offset + 'px';
      button.setAttribute('aria-expanded', 'true');
      var sel = list.querySelector('[aria-selected="true"]');
      if (sel) sel.scrollIntoView({block: 'nearest'});
      if (search) search.focus();
    }

    button.addEventListener('click', function (e) { e.stopPropagation(); open(); });
    document.addEventListener('click', function (e) {
      if (panel && !wrap.contains(e.target)) close();
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && panel) { close(); button.focus(); }
    });
    // Anything that changes the value elsewhere - Clear, the default time
    // window, a chip being removed - has to be reflected on the button.
    select.addEventListener('change', label);
    label();
  }

  [fVenue, fGenre, fFrom, fTo].forEach(makePicker);

  // Coming back from a show should land where you left, not at the top of a
  // list you have already scrolled through. The show is remembered on the way
  // out, because on the way back the page has no idea which one you followed.
  document.addEventListener('click', function (event) {
    var link = event.target.closest && event.target.closest('a[href*="show/"]');
    if (!link) return;
    try { sessionStorage.setItem('fringestars-from', link.getAttribute('href')); }
    catch (e) {}
    // The filter also travels IN the link, not only in storage. sessionStorage
    // belongs to one tab: a review opens with target="_blank", and anything
    // that ends up browsing in that new tab has no storage to read, so the
    // filter was lost on the way back. Carried in the URL it survives a new
    // tab, a restored tab, a shared link and a browser that has thrown its
    // storage away.
    // The board names itself in the link as well as passing its filters, so a
    // show page knows which board to send the reader back to. Without it every
    // show returns to the live year, which is right for someone arriving from
    // search and wrong for someone reading last year's board.
    var here = location.pathname.split('/').pop() || '';
    var parts = [];
    if (location.search.length > 1) parts.push(location.search.slice(1));
    if (/^\d{4}\.html$/.test(here)) parts.push('board=' + here);
    var href = link.getAttribute('href');
    if (parts.length && href.indexOf('?') === -1) {
      link.setAttribute('href', href + '?' + parts.join('&'));
    }
  });

  function returnToShow() {
    var href;
    try { href = sessionStorage.getItem('fringestars-from'); } catch (e) { return; }
    if (!href) return;
    try { sessionStorage.removeItem('fringestars-from'); } catch (e) {}
    var link = document.querySelector('a[href="' + href.replace(/"/g, '\\"') + '"]');
    if (!link) return;                      // filtered out, or a different year
    var row = link.closest('article.show') || link;
    // 'center' rather than the top, so the show you were reading is where your
    // eye already is rather than tucked under the header.
    row.scrollIntoView({block: 'center'});
  }

  var qClear = document.getElementById('q-clear');
  function showClear() {
    if (qClear) qClear.hidden = !input.value;
  }
  if (qClear) {
    qClear.addEventListener('click', function () {
      input.value = '';
      input.dispatchEvent(new Event('input', {bubbles: true}));
      input.focus();
    });
  }
  // The bar compacts once the header has scrolled past. Measured against the
  // header rather than a made-up number, so it behaves the same on a phone as on
  // a desktop, where the header is a very different height.
  var topbar = document.getElementById('topbar');
  var toTop = document.getElementById('to-top');
  if (topbar && toTop) {
    var heading = document.querySelector('header h1');
    function onScroll() {
      var past = heading
        ? window.scrollY > heading.getBoundingClientRect().height + 40
        : window.scrollY > 120;
      topbar.classList.toggle('compact', past);
      toTop.hidden = !past;
    }
    toTop.addEventListener('click', function () {
      window.scrollTo({top: 0, behavior: 'smooth'});
    });
    window.addEventListener('scroll', onScroll, {passive: true});

    // Let go of the search box once you start scrolling the results. On iOS the
    // keyboard shrinks the visual viewport while the bar stays pinned to the
    // layout one, so it sits above the visible area and reads as having
    // scrolled away. Dismissing the keyboard puts it back, and by the time
    // someone is scrolling results they have finished typing anyway.
    //
    // Bound to touchmove and wheel rather than scroll: those only happen when a
    // person moves the page, where scroll also fires when the keyboard opens and
    // would blur the field the instant it was tapped.
    ['touchmove', 'wheel'].forEach(function (event) {
      window.addEventListener(event, function () {
        if (document.activeElement === input) input.blur();
      }, {passive: true});
    });

    onScroll();
  }

  input.addEventListener('input', showClear);
  input.addEventListener('input', apply);
  input.addEventListener('search', apply);   // the clear (x) button

  // The time window starts empty. It used to open on the next two hours - "what
  // can I get to shortly" - but the defaults were only ever displayed, never
  // applied: the controls read 21:00 to 23:00 above a list showing every show at
  // every hour. A filter that says it is on while doing nothing is worse than no
  // default, so the honest reading of those boxes is now the true one.

  // Dates that have already gone. Removed here rather than left out at build
  // time, because a page written this morning is still being read tonight, and
  // from caches for longer than that — the reader's clock is the one that knows
  // which dates are still worth offering.
  if (fPlaying) {
    var gone = todayOffset();
    [].slice.call(fPlaying.options).forEach(function (option) {
      if (option.value.charAt(0) === 'd'
          && parseInt(option.value.slice(1), 10) < gone) {
        option.parentNode.removeChild(option);
      }
    });
  }

  [fFrom, fTo, fPlaying].forEach(function (el) {
    if (el) el.addEventListener('change', apply);
  });

  // Genre and Location both hold several choices at once, so the chip list is
  // built once and used twice rather than written out again per control.
  // Choosing an option turns it into a chip and returns the picker to "Any
  // venue" / "Any genre", so the next choice adds rather than overwrites.
  function multiPick(select, box) {
    if (!select || !box) return {values: function () { return []; }, clear: function () {}};
    var chosen = [];

    function labelFor(value) {
      for (var i = 0; i < select.options.length; i++) {
        if (select.options[i].value === value) return select.options[i].text;
      }
      return value;
    }

    // An option already chosen is greyed out rather than removed, so the list
    // does not reshuffle under the finger of someone picking a second one.
    function setDisabled(value, state) {
      for (var i = 0; i < select.options.length; i++) {
        if (select.options[i].value === value) select.options[i].disabled = state;
      }
    }

    function draw() {
      box.textContent = '';
      chosen.forEach(function (value) {
        var chip = document.createElement('button');
        chip.type = 'button';
        // The name goes in its own element so it can be truncated on a narrow
        // screen while the × stays put. Left as one run of text, "Theatre – New
        // writing ×" wrapped in the middle and dropped the × onto a second line.
        var name = document.createElement('span');
        name.className = 'chip-name';
        name.textContent = labelFor(value);
        chip.appendChild(name);
        chip.setAttribute('aria-label', 'Remove ' + labelFor(value) + ' filter');
        chip.addEventListener('click', function () {
          chosen = chosen.filter(function (v) { return v !== value; });
          setDisabled(value, false);
          draw();
          apply();
        });
        box.appendChild(chip);
      });
    }

    select.addEventListener('change', function () {
      var value = select.value;
      select.value = '';
      if (!value || chosen.indexOf(value) !== -1) return;
      chosen.push(value);
      setDisabled(value, true);
      draw();
      apply();
    });

    return {
      values: function () { return chosen; },
      // Used when restoring from the URL. Silent: it does not call apply(),
      // because the restore sets every control first and applies once at the end.
      restore: function (list) {
        list.forEach(function (v) {
          if (chosen.indexOf(v) !== -1) return;
          for (var i = 0; i < select.options.length; i++) {
            if (select.options[i].value === v) {
              chosen.push(v);
              setDisabled(v, true);
              return;
            }
          }
        });
        draw();
      },
      clear: function () {
        chosen.forEach(function (v) { setDisabled(v, false); });
        chosen = [];
        draw();
      }
    };
  }

  venuePick = multiPick(fVenue, fVenueChosen);
  genrePick = multiPick(fGenre, fGenreChosen);


  // Keep the filter in the address bar. Going to a show and pressing back used
  // to land on a bare leaderboard with every choice thrown away; with the state
  // in the URL the browser restores it for free, and a filtered view becomes
  // something you can send to someone.
  //
  // replaceState, not pushState: typing in the search box would otherwise add a
  // history entry per keystroke and back would walk through them one at a time.
  function writeState() {
    if (!window.history || !history.replaceState) return;
    var params = [];
    function add(key, value) {
      params.push(encodeURIComponent(key) + '=' + encodeURIComponent(value));
    }
    var q = input.value.trim();
    if (q) add('q', q);
    // Repeated keys rather than one comma-joined value, because venue names
    // contain commas - "Underbelly, Cowgate" would split into two.
    if (venuePick) venuePick.values().forEach(function (v) { add('venue', v); });
    if (genrePick) genrePick.values().forEach(function (v) { add('genre', v); });
    if (fFrom && fFrom.value) add('from', fFrom.value);
    if (fTo && fTo.value) add('to', fTo.value);
    if (fPlaying && fPlaying.value) add('playing', fPlaying.value);
    var query = params.join('&');
    history.replaceState(null, '', location.pathname + (query ? '?' + query : ''));
    // Also kept for the session, because the browser's back button is not the
    // only way back: every show page carries its own "← Top-Rated Shows" link,
    // which is an ordinary link to a bare URL and throws the filter away.
    try { sessionStorage.setItem('fringestars-filter', query); } catch (e) {}
  }

  function readState() {
    // The address bar wins, so a link someone was sent shows what it says.
    // Otherwise fall back to what this tab was last looking at.
    var search = location.search.slice(1);
    if (!search) {
      try { search = sessionStorage.getItem('fringestars-filter') || ''; }
      catch (e) { search = ''; }
    }
    if (!search) return false;
    // A hand-edited or truncated URL must not be able to throw here: anything
    // that escapes this function stops the rest of the script attaching its
    // handlers, and "?q=%%%" alone was enough to leave Clear doing nothing.
    function decode(text) {
      try { return decodeURIComponent(text.replace(/\+/g, ' ')); }
      catch (e) { return ''; }
    }
    var venues = [], genres = [], q = '', from = '', to = '', when = '';
    search.split('&').forEach(function (pair) {
      var bits = pair.split('=');
      var key = decode(bits[0]);
      var value = decode(bits[1] || '');
      if (key === 'venue') venues.push(value);
      else if (key === 'genre') genres.push(value);
      else if (key === 'q') q = value;
      else if (key === 'from') from = value;
      else if (key === 'to') to = value;
      else if (key === 'playing') when = value;
    });
    if (q) input.value = q;
    if (venuePick) venuePick.restore(venues);
    if (genrePick) genrePick.restore(genres);
    function setIf(select, value) {
      if (!select || !value) return;
      for (var i = 0; i < select.options.length; i++) {
        if (select.options[i].value === value) { select.value = value; return; }
      }
    }
    setIf(fFrom, from);
    setIf(fTo, to);
    setIf(fPlaying, when);
    return !!(q || venues.length || genres.length || from || to || when);
  }

  if (fClear) {
    fClear.addEventListener('click', function () {
      // Dispatched, not just assigned: the drawn buttons follow the select's
      // change event, and without it Clear emptied the filter while every
      // button still showed the choice it had just thrown away.
      function reset(el) {
        if (!el) return;
        el.value = '';
        el.dispatchEvent(new Event('change', {bubbles: true}));
      }
      // The search box is part of the filter as far as a reader is concerned,
      // even though it sits outside the panel. Leaving it set meant Clear
      // visibly emptied everything and the list stayed cut down.
      if (input) {
        input.value = '';
        input.dispatchEvent(new Event('input', {bubbles: true}));
      }
      venuePick.clear();
      genrePick.clear();
      reset(fVenue);
      reset(fGenre);
      reset(fFrom);
      reset(fTo);
      reset(fPlaying);
      apply();          // Clear means clear: back to every show, not back to "from now"
      // And put the panel away. Clear is the last thing anyone does in it, and
      // leaving it open hides the list they have just asked to see all of.
      if (toggle && panel) {
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
      }

    });
  }
  if (readState()) {
    // The panel opens itself, so a restored filter is visible rather than
    // quietly cutting the list down for reasons the reader cannot see.
    if (toggle && panel) {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
    }
    [fFrom, fTo].forEach(function (el) {
      if (el) el.dispatchEvent(new Event('change', {bubbles: true}));
    });
    apply();
  }

  // A search restored from the URL or the session needs its clear button too.
  showClear();

  // Last, and after any filter has been applied: scrolling to a row that is
  // about to be hidden would leave the page somewhere arbitrary.
  returnToShow();

})();
</script>
{% if analytics_token %}
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "{{ analytics_token }}"}'></script>
{% endif %}
</body>
</html>
