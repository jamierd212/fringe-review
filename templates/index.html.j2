<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edinburgh Festivals Top-Rated Shows {{ year }}</title>
<meta name="description" content="Edinburgh Fringe &amp; festivals shows ranked by highest rating, featuring every published review we can find.">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<meta property="og:site_name" content="Edinburgh Festivals Top-Rated Shows">
<meta property="og:type" content="website">
{% if canonical %}<meta property="og:url" content="{{ canonical }}">{% endif %}
<meta property="og:title" content="Edinburgh Festivals {{ year }} &ndash; Top-Rated Shows">
<meta property="og:description" content="{{ rated }} star ratings across {{ show_count }} shows, collated from {{ publications|length }} publications and ranked by highest rating.">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="Edinburgh Festivals {{ year }} &ndash; Top-Rated Shows">
<meta name="twitter:description" content="{{ rated }} star ratings across {{ show_count }} shows, ranked by highest rating.">
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --rule: #ecdcd9;
    --star: #c62828;            /* red, replaces the old gold */
    --bg: #f9e4e0;              /* light red page background */
    --card: #ffffff;            /* boxes deliberately left white */
  }
  * { box-sizing: border-box; }
  /* The `hidden` attribute is only `display: none` in the user-agent
     stylesheet, so ANY author rule setting display beats it — `.show` is
     display:flex, which meant search hid rows in the DOM while leaving every
     one of them on screen. */
  [hidden] { display: none !important; }
  body {
    margin: 0; padding: 2rem .6rem 4rem; background: var(--bg); color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
  }
  .wrap { max-width: 820px; margin: 0 auto; }
  header { border-bottom: 3px solid #ccc; padding-bottom: .8rem; margin-bottom: .5rem; }
  h1 { font-size: 2rem; margin: 0 0 .25rem; letter-spacing: -.01em; line-height: 1.15; }
  h1 .line2 { display: block; }   /* inherits h1's size, weight and colour */
  .sub { color: var(--muted); font-size: .85rem; }
  .meta {
    color: var(--muted); font-size: .7rem; line-height: 1.3;
    margin: .55rem 0 1.2rem;
  }

  .show {
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: .4rem .7rem; margin-bottom: .27rem; display: flex; gap: .6rem;
  }
  .pos {
    /* Matched to h2 so the number and the show title sit on the same line and
       at the same weight — the number is a label, not the headline. */
    font-size: 1.15rem; font-weight: 700; color: var(--muted);
    line-height: 1.35; min-width: 1.9rem;
    text-align: right; font-variant-numeric: tabular-nums;
  }
  .body { flex: 1; min-width: 0; }
  .titlerow { display: flex; gap: .7rem; align-items: baseline; justify-content: space-between; }
  .titlewrap { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; min-width: 0; }
  h2 { font-size: 1.15rem; margin: 0 0 .05rem; line-height: 1.35; }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-color: var(--star); }
  .meta-right { flex: none; display: flex; gap: .45rem; align-items: baseline; }
  .genre {
    font-size: .72rem; letter-spacing: .04em; text-transform: uppercase;
    color: var(--muted); border: 1px solid var(--rule); border-radius: 999px;
    padding: .12rem .55rem;
  }
  .performer { color: var(--muted); font-size: .85rem; }
  @media (max-width: 560px) {
    .titlerow { flex-direction: column; gap: .2rem; }
    .meta-right { align-self: flex-start; }
  }

  ul.reviews { list-style: none; margin: .08rem 0 0; padding: 0; }
  ul.reviews li {
    display: flex; gap: .7rem; align-items: baseline;
    padding: .09rem 0; line-height: 1.2; border-top: 1px solid var(--rule);
    flex-wrap: wrap;
  }
  ul.reviews li:first-child { border-top: 0; }
  .rating {
    font-family: ui-monospace, Menlo, monospace; letter-spacing: .08em;
    white-space: nowrap; color: var(--star);
    font-size: 1.15rem;         /* slightly larger than the surrounding text */
  }
  .s3 .rating, .s2 .rating, .s1 .rating { color: var(--muted); }
  .pub { flex: 1; min-width: 0; }
  .pub { overflow-wrap: anywhere; }
  a { color: inherit; text-decoration-color: var(--rule); text-underline-offset: 2px; }
  /* Publication names are links, but a column of underlines competes with the
     stars beside them. Underline only on hover, so they still read as links. */
  .pub a { text-decoration: none; }
  .pub a:hover { text-decoration: underline; text-decoration-color: var(--ink); }
  a:hover { text-decoration-color: var(--ink); }

  nav.years { display: flex; gap: .4rem; margin: .9rem 0 0; flex-wrap: wrap; }
  nav.years a {
    display: inline-block; padding: .3rem .85rem; border: 1px solid var(--rule);
    border-radius: 999px; text-decoration: none; font-size: .9rem;
    color: var(--muted); background: var(--card);
  }
  nav.years a:hover { border-color: var(--ink); color: var(--ink); }
  nav.years a[aria-current="page"] {
    background: var(--ink); border-color: var(--ink); color: var(--bg);
    font-weight: 700;
  }

  nav.years .filter-toggle {
    margin-left: auto; padding: .3rem .85rem; border: 1px solid var(--rule);
    border-radius: 999px; font: inherit; font-size: .9rem; color: var(--muted);
    background: var(--card); cursor: pointer;
  }
  nav.years .filter-toggle:hover { border-color: var(--ink); color: var(--ink); }
  nav.years .filter-toggle[aria-expanded="true"] {
    background: var(--ink); border-color: var(--ink); color: var(--bg);
  }
  nav.years .search { margin-left: .4rem; }
  .filters {
    display: flex; flex-wrap: wrap; gap: .9rem 1.2rem; align-items: end;
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: .7rem .9rem; margin: .5rem 0 0; font-size: .85rem;
  }
  .filters label { display: flex; flex-direction: column; gap: .25rem; color: var(--muted); }
  .filters select {
    font: inherit; padding: .25rem .4rem; border: 1px solid var(--rule);
    border-radius: 4px; background: #fff; color: var(--ink); max-width: 15rem;
  }
  .filters .times { display: flex; align-items: center; gap: .35rem; }
  .filters #f-clear {
    font: inherit; padding: .3rem .7rem; border: 1px solid var(--rule);
    border-radius: 999px; background: var(--card); color: var(--muted); cursor: pointer;
  }
  .filters #f-clear:hover { border-color: var(--ink); color: var(--ink); }
  @media (max-width: 560px) {
    nav.years .search { margin-left: 0; }
    nav.years input[type="search"] { width: 100%; }
  }
  nav.years input[type="search"] {
    padding: .3rem .85rem; border: 1px solid var(--rule); border-radius: 999px;
    font-size: .9rem; font-family: inherit; color: var(--ink);
    background: var(--card); width: 8.5rem; -webkit-appearance: none;
  }
  nav.years input[type="search"]:focus {
    outline: none; border-color: var(--ink);
  }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }
  .nomatch { color: var(--muted); font-style: italic; margin: 1.5rem 0; }

  .placeholder { color: var(--muted); font-size: 1.05rem; margin: 2rem 0 3rem; }
  h3.section { margin: 2.5rem 0 .75rem; font-size: 1rem; text-transform: uppercase;
               letter-spacing: .08em; color: var(--muted); }
  .rest { columns: 2; column-gap: 1.5rem; font-size: .9rem; }
  .rest div { break-inside: avoid; margin-bottom: .4rem; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule);
           color: var(--muted); font-size: .8rem; }
  @media (max-width: 560px) { .rest { columns: 1; } }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Edinburgh Festivals<span class="line2">Top-Rated Shows</span></h1>
  <p class="sub">
    Edinburgh Fringe &amp; festivals shows ranked by highest rating, featuring
    every published review we can find.
  </p>
  {% if nav|length > 1 %}
  <nav class="years" aria-label="Festival year">
    {% for entry in nav %}
    <a href="{{ entry.href }}"{% if entry.current %} aria-current="page"{% endif %}>{{ entry.year }}</a>
    {% endfor %}
    {#- No programme, no filter. Past years lose their venues and times when the
        festival takes its pages down, so offering the control there would open
        an empty panel. -#}
    {% if venues %}
    <button type="button" class="filter-toggle" id="filter-toggle" aria-expanded="false"
            aria-controls="filters" hidden>Filter</button>
    {% endif %}
    <label class="search" hidden>
      <span class="visually-hidden">Search shows</span>
      <input type="search" id="q" placeholder="Search shows&hellip;"
             autocomplete="off" spellcheck="false">
    </label>
  </nav>
  {# Populated from the festival's own programme; absent for past years, whose
     programme pages come down once the shows stop selling. #}
  {% if venues %}
  <div class="filters" id="filters" hidden>
    <label>Venue
      <select id="f-venue">
        <option value="">Any venue</option>
        {% for v in venues %}<option value="{{ v }}">{{ v }}</option>{% endfor %}
      </select>
    </label>
    <label>Starts between
      <span class="times">
        {#- Whole hours rather than a time picker: show times are only ever
            useful to about the hour when you are deciding what to go and see,
            and a native time input is fiddly on a phone. -#}
        <select id="f-from">
          <option value="">Any time</option>
          {% for h in range(24) %}<option value="{{ "%02d:00"|format(h) }}">{{ "%02d:00"|format(h) }}</option>{% endfor %}
        </select>
        <span>and</span>
        <select id="f-to">
          <option value="">Any time</option>
          {% for h in range(24) %}<option value="{{ "%02d:00"|format(h) }}">{{ "%02d:00"|format(h) }}</option>{% endfor %}
        </select>
      </span>
    </label>
    <button type="button" id="f-clear">Clear</button>
  </div>
  {% endif %}
  {% endif %}
</header>

<p class="meta">
  Updated {{ updated }}{% if rated %} &middot;
  {{ rated }} rated reviews across {{ show_count }} shows{% endif %}
</p>

{% for position, show in placed %}
<article class="show{% if position <= 3 %} top{% endif %}"
         data-find="{{ (show.title ~ ' ' ~ (show.performer or '') ~ ' ' ~ show.genre)|lower }}"
         data-venue="{{ show.venue }}" data-start="{{ show.start_minutes }}">
  <div class="pos">{{ position }}</div>
  <div class="body">
    <div class="titlerow">
      <span class="titlewrap">
        <h2><a href="{{ show.page }}" title="All reviews for {{ show.title }}">{{ show.title }}</a></h2>
        {% if show.performer %}<span class="performer">{{ show.performer }}</span>{% endif %}
      </span>
      <span class="meta-right">
        {% if show.genre %}<span class="genre">{{ show.genre }}</span>{% endif %}
      </span>
    </div>
    <ul class="reviews">
      {% for level in [5, 4, 3, 2, 1] %}
        {% for review in show.at(level) %}
        <li class="s{{ level }}">
          <span class="rating" title="{{ level }} out of 5">{{ level|stars }}</span>
          <span class="pub"><a href="{{ review.url }}" target="_blank" rel="nofollow noopener">{{ review.publication }}</a></span>
        </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</article>
{% else %}
<p class="placeholder"><em>2026 reviews go live Wednesday 5th August</em></p>
{% endfor %}

{% if rest %}
<h3 class="section">Also reviewed &mdash; no 4 or 5 star reviews yet</h3>
<div class="rest">
  {% for show in rest %}
  <div data-find="{{ show.title|lower }}"
       data-venue="{{ show.venue }}" data-start="{{ show.start_minutes }}">
    {{ show.title }}
    {% for review in show.reviews %}
      <a href="{{ review.url }}" target="_blank" rel="nofollow noopener" title="{{ review.publication }}">{{ review.stars }}&#9733;</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}

<footer>
  {% if publications %}<p>
    <strong>Sources:</strong> {{ publications|join(", ") }}.
  </p>{% endif %}
  <p>
    Ratings are collated automatically from publicly available reviews and link
    back to the publication. Ratings given on other scales are converted to
    stars, rounded down, and labelled. Star ratings are the publications&rsquo;
    own; this page only counts them.
  </p>
  <p>
    Spotted a mistake? <a href="{{ contact_url }}" rel="noopener">{{ contact_label }}</a>
    and we&rsquo;ll fix it. Publications wanting a rating amended or removed:
    same route &mdash; it will be actioned.
  </p>
</footer>

</div>

<p class="nomatch" id="nomatch" hidden></p>

<script>
// Search is client-side because the site is static files on a CDN. The box is
// hidden in the markup and revealed here, so it never appears as a dead control
// for anyone without JavaScript.
(function () {
  var box = document.querySelector('.search');
  var input = document.getElementById('q');
  var none = document.getElementById('nomatch');
  if (!box || !input) return;
  box.hidden = false;

  // Read the text once. Doing it per keystroke means touching a thousand
  // elements' DOM text on every character typed.
  var rows = [].map.call(document.querySelectorAll('[data-find]'), function (el) {
    return { el: el, text: el.getAttribute('data-find') };
  });
  var section = document.querySelector('h3.section');
  var rest = document.querySelector('.rest');

  // Filters. The panel only exists where the festival programme supplied
  // venues and times, so every reference below is optional.
  var toggle = document.getElementById('filter-toggle');
  var panel = document.getElementById('filters');
  var fVenue = document.getElementById('f-venue');
  var fFrom = document.getElementById('f-from');
  var fTo = document.getElementById('f-to');
  var fClear = document.getElementById('f-clear');

  rows.forEach(function (r) {
    r.venue = r.el.getAttribute('data-venue') || '';
    r.start = parseInt(r.el.getAttribute('data-start'), 10);
  });

  function minutes(value) {
    if (!value) return null;
    var bits = value.split(':');
    return parseInt(bits[0], 10) * 60 + parseInt(bits[1], 10);
  }

  function apply() {
    var q = input.value.trim().toLowerCase();
    var venue = fVenue ? fVenue.value : '';
    var from = fFrom ? minutes(fFrom.value) : null;
    var to = fTo ? minutes(fTo.value) : null;
    var hits = 0;
    for (var i = 0; i < rows.length; i++) {
      var r = rows[i];
      var show = !q || r.text.indexOf(q) !== -1;
      if (show && venue) show = r.venue === venue;
      // A show with no known time cannot satisfy a time window. Hiding it is
      // the honest answer: we do not know when it is on, so we cannot claim
      // it starts in the hour someone asked for.
      if (show && (from !== null || to !== null)) {
        show = r.start >= 0
            && (from === null || r.start >= from)
            && (to === null || r.start <= to);
      }
      r.el.hidden = !show;
      if (show) hits++;
    }
    // The "also reviewed" heading and its column are meaningless when nothing
    // in them matches.
    if (rest) {
      var anyRest = [].some.call(rest.querySelectorAll('[data-find]'), function (e) {
        return !e.hidden;
      });
      rest.hidden = !anyRest;
      if (section) section.hidden = !anyRest;
    }
    var filtering = q || venue || from !== null || to !== null;
    none.hidden = !(filtering && hits === 0);
    if (!none.hidden) none.textContent = 'No shows match those filters.';
  }

  input.addEventListener('input', apply);
  input.addEventListener('search', apply);   // the clear (x) button

  if (toggle && panel) {
    toggle.hidden = false;
    toggle.addEventListener('click', function () {
      var open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
    });
  }
  // Default to a two-hour window starting now: "what can I get to shortly".
  // Set here rather than at build time because the pages are generated once a
  // day and cached, so a server-rendered "now" would be stale for almost
  // everyone reading it.
  function setHour(select, hour) {
    if (!select) return;
    var value = String(hour).padStart(2, '0') + ':00';
    if ([].some.call(select.options, function (o) { return o.value === value; })) {
      select.value = value;
    }
  }
  var nowHour = new Date().getHours();
  setHour(fFrom, nowHour);
  // Clamped rather than wrapped: 23:00 is the last option, and a window that
  // ran from 22:00 round to 00:00 would exclude everything between them.
  setHour(fTo, Math.min(nowHour + 2, 23));

  [fVenue, fFrom, fTo].forEach(function (el) {
    if (el) el.addEventListener('change', apply);
  });
  if (fClear) {
    fClear.addEventListener('click', function () {
      if (fVenue) fVenue.value = '';
      if (fFrom) fFrom.value = '';
      if (fTo) fTo.value = '';
      apply();          // Clear means clear: back to every show, not back to "from now"

    });
  }
})();
</script>
{% if analytics_token %}
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "{{ analytics_token }}"}'></script>
{% endif %}
</body>
</html>
