<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edinburgh Festival Review Leaderboard {{ year }}</title>
<meta name="description" content="Star-rated reviews of Edinburgh Festival shows, collated and ranked.">
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --rule: #e3e3e3;
    --gold: #c8a02c; --bg: #fbfaf8; --card: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1rem 4rem; background: var(--bg); color: var(--ink);
    font: 16px/1.5 ui-serif, Georgia, "Times New Roman", serif;
  }
  .wrap { max-width: 820px; margin: 0 auto; }
  header { border-bottom: 3px double var(--ink); padding-bottom: 1rem; margin-bottom: .5rem; }
  h1 { font-size: 2rem; margin: 0 0 .25rem; letter-spacing: -.01em; }
  .sub, .meta { color: var(--muted); font-size: .85rem; }
  .meta { margin: .75rem 0 2rem; }

  .show {
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: 1rem 1.1rem; margin-bottom: .75rem; display: flex; gap: 1rem;
  }
  .pos {
    font-size: 1.5rem; font-weight: 700; color: var(--muted);
    min-width: 2.4rem; text-align: right; font-variant-numeric: tabular-nums;
  }
  .show.top .pos { color: var(--gold); }
  .body { flex: 1; min-width: 0; }
  h2 { font-size: 1.15rem; margin: 0 0 .1rem; }
  .performer { color: var(--muted); font-size: .9rem; margin-bottom: .6rem; }

  ul.reviews { list-style: none; margin: 0; padding: 0; }
  ul.reviews li {
    display: flex; gap: .7rem; align-items: baseline;
    padding: .18rem 0; border-top: 1px solid var(--rule); flex-wrap: wrap;
  }
  ul.reviews li:first-child { border-top: 0; }
  .rating {
    font-family: ui-monospace, Menlo, monospace; letter-spacing: .06em;
    white-space: nowrap; color: var(--gold);
  }
  .s3 .rating, .s2 .rating, .s1 .rating { color: var(--muted); }
  .pub { flex: 1; min-width: 0; }
  .note {
    font-size: .72rem; color: var(--muted); font-style: italic;
    border: 1px solid var(--rule); border-radius: 3px; padding: 0 .3rem;
  }
  a { color: inherit; text-decoration-color: var(--rule); text-underline-offset: 2px; }
  a:hover { text-decoration-color: var(--ink); }

  h3.section { margin: 2.5rem 0 .75rem; font-size: 1rem; text-transform: uppercase;
               letter-spacing: .08em; color: var(--muted); }
  .rest { columns: 2; column-gap: 1.5rem; font-size: .9rem; }
  .rest div { break-inside: avoid; margin-bottom: .4rem; }
  footer { margin-top: 3rem; padding-top: 1rem; border-top: 1px solid var(--rule);
           color: var(--muted); font-size: .8rem; }
  @media (max-width: 560px) { .rest { columns: 1; } .pos { font-size: 1.2rem; min-width: 1.8rem; } }
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>Edinburgh Festival Review Leaderboard {{ year }}</h1>
  <p class="sub">
    Every star-rated review we can find, ranked Olympic-style: one 5-star review
    outranks any number of 4-star reviews. Lower ratings are shown for reference
    but do not affect position.
  </p>
</header>

<p class="meta">
  Updated {{ updated }} &middot;
  {{ stats.rated }} rated reviews across {{ stats.shows }} shows &middot;
  Sources: {{ publications|join(", ") }}
</p>

{% for position, show in placed %}
<article class="show{% if position <= 3 %} top{% endif %}">
  <div class="pos">{{ position }}</div>
  <div class="body">
    <h2>{{ show.title }}</h2>
    {% if show.performer %}<div class="performer">{{ show.performer }}</div>{% endif %}
    <ul class="reviews">
      {% for level in [5, 4, 3, 2, 1] %}
        {% for review in show.at(level) %}
        <li class="s{{ level }}">
          <span class="rating" title="{{ level }} out of 5">{{ level|stars }}</span>
          <span class="pub"><a href="{{ review.url }}" rel="nofollow noopener">{{ review.publication }}</a></span>
          {% if review.note %}<span class="note">{{ review.note }}</span>{% endif %}
        </li>
        {% endfor %}
      {% endfor %}
    </ul>
  </div>
</article>
{% else %}
<p><em>No rated reviews yet. The leaderboard fills up once the festival starts.</em></p>
{% endfor %}

{% if rest %}
<h3 class="section">Also reviewed &mdash; no 4 or 5 star reviews yet</h3>
<div class="rest">
  {% for show in rest %}
  <div>
    {{ show.title }}
    {% for review in show.reviews %}
      <a href="{{ review.url }}" rel="nofollow noopener" title="{{ review.publication }}">{{ review.stars }}&#9733;</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}

<footer>
  <p>
    Ratings are collated automatically from publicly available reviews and link
    back to the publication. Ratings given on other scales are converted to
    stars, rounded down, and labelled. Star ratings are the publications&rsquo;
    own; this page only counts them.
  </p>
  <p>Spotted a mistake? <a href="mailto:YOUR-EMAIL-HERE">Let us know</a> and we&rsquo;ll fix it.</p>
</footer>

</div>
</body>
</html>
