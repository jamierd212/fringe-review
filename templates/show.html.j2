<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ show.title }} &ndash; reviews and star ratings, Edinburgh {{ year }}</title>
<meta name="description" content="Every star-rated review we can find for {{ show.title }} at the Edinburgh {{ festival_name }} {{ year }}{% if show.average %}, averaging {{ show.average }} out of 5 across {{ show.total }} reviews{% endif %}.">
<link rel="canonical" href="{{ site_url }}/{{ show.page }}">
<style>
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b; --rule: #ecdcd9;
    --star: #c62828; --bg: #f9e4e0; --card: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0; padding: 2rem 1rem 4rem; background: var(--bg); color: var(--ink);
    font: 16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          "Helvetica Neue", Arial, sans-serif;
  }
  .wrap { max-width: 720px; margin: 0 auto; }
  .back { font-size: .85rem; color: var(--muted); text-decoration: none; }
  .back:hover { color: var(--ink); }
  .card {
    background: var(--card); border: 1px solid var(--rule); border-radius: 6px;
    padding: 1.4rem 1.5rem; margin-top: 1rem;
  }
  .titlerow { display: flex; gap: 1.2rem; align-items: baseline; justify-content: space-between; }
  h1 { font-size: 1.5rem; margin: 0 0 .2rem; line-height: 1.25; }
  .venue {
    flex: none; font-size: .8rem; color: var(--muted); text-align: right;
    max-width: 40%;
  }
  @media (max-width: 560px) {
    .titlerow { flex-direction: column; gap: .15rem; }
    .venue { text-align: left; max-width: none; }
  }
  .performer { color: var(--muted); margin-bottom: .8rem; }
  .genre {
    display: inline-block; font-size: .72rem; letter-spacing: .04em;
    text-transform: uppercase; color: var(--star); border: 1px solid var(--rule);
    border-radius: 999px; padding: .12rem .55rem; margin-bottom: .8rem;
  }
  .summary {
    border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule);
    padding: .8rem 0; margin: .9rem 0 1rem;
  }
  .avg { font-size: 1.6rem; font-weight: 700; color: var(--star); }
  .avg small { font-size: .95rem; font-weight: 400; color: var(--muted); }
  ul.reviews { list-style: none; margin: 0; padding: 0; }
  ul.reviews li {
    display: flex; gap: .7rem; align-items: baseline; flex-wrap: wrap;
    padding: .23rem 0; line-height: 1.35; border-top: 1px solid var(--rule);
  }
  ul.reviews li:first-child { border-top: 0; }
  .rating {
    font-family: ui-monospace, Menlo, monospace; letter-spacing: .08em;
    white-space: nowrap; color: var(--star); font-size: 1.15rem;
  }
  .s3 .rating, .s2 .rating, .s1 .rating { color: var(--muted); }
  .pub { flex: 1; min-width: 0; }
  .note {
    font-size: .72rem; color: var(--muted); font-style: italic;
    border: 1px solid var(--rule); border-radius: 3px; padding: 0 .3rem;
    flex: none;
  }
  /* min-width:0 lets .pub shrink below its own text, which made the badge sit
     on top of the publication name on a phone. Wrapping the name fixes the
     overlap while keeping the badge on the same line. */
  .pub { overflow-wrap: anywhere; }
  .official { display: inline-block; margin-top: 1rem; font-size: .9rem; }
  a { color: inherit; text-decoration-color: var(--rule); text-underline-offset: 2px; }
  /* Publication names are links, but a column of underlines competes with the
     stars beside them. Underline only on hover, so they still read as links. */
  .pub a { text-decoration: none; }
  .pub a:hover { text-decoration: underline; text-decoration-color: var(--ink); }
  a:hover { text-decoration-color: var(--ink); }
  footer { margin-top: 2rem; color: var(--muted); font-size: .8rem; }
</style>
<script type="application/ld+json">
{{ jsonld }}
</script>
</head>
<body>
<div class="wrap">

<a class="back" href="{{ back_href }}">&larr; Edinburgh Festivals Top-Rated Shows {{ year }}</a>

<div class="card">
  <div class="titlerow">
    <h1>{{ show.title }}</h1>
    {% if show.venue %}<span class="venue">{{ show.venue }}</span>{% endif %}
  </div>
  {% if show.performer %}<div class="performer">{{ show.performer }}</div>{% endif %}
  {% if show.genre %}<span class="genre">{{ show.genre }}</span>{% endif %}

  <div class="summary">
    {% if show.average %}
      <span class="avg">{{ show.average }}<small> / 5</small></span>
      <small>average across {{ show.total }} review{{ '' if show.total == 1 else 's' }}</small>
    {% else %}
      <small>{{ show.total }} review{{ '' if show.total == 1 else 's' }}</small>
    {% endif %}
  </div>

  <ul class="reviews">
    {% for level in [5, 4, 3, 2, 1] %}
      {% for review in show.at(level) %}
      <li class="s{{ level }}">
        <span class="rating" title="{{ level }} out of 5">{{ level|stars }}</span>
        <span class="pub"><a href="{{ review.url }}" target="_blank" rel="nofollow noopener">{{ review.publication }}</a></span>
        {% if review.note %}<span class="note">{{ review.note }}</span>{% endif %}
      </li>
      {% endfor %}
    {% endfor %}
  </ul>

  {% if show.url %}
  <a class="official" href="{{ show.url }}" rel="noopener">Official {{ festival_name }} programme entry &rarr;</a>
  {% endif %}
</div>

<footer>
  <p>
    Star ratings are the publications&rsquo; own; this page collates and links to
    them. Ratings published on other scales are converted, rounded down and
    labelled. Spotted a mistake?
    <a href="{{ contact_url }}" rel="noopener">{{ contact_label }}</a>.
  </p>
</footer>

</div>
</body>
</html>
